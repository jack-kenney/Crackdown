+  // Already dirty bindings keep the ordinary SIMD copy below.
+  auto copy_range_and_check_changes = [this, start_index, base](uint32_t first,
+                                                              uint32_t last) {
+    const __m128i shuffle = _mm_set_epi8(12, 13, 14, 15, 8, 9, 10, 11,
+                                        4, 5, 6, 7, 0, 1, 2, 3);
+    __m128i differences = _mm_setzero_si128();
+    uint32_t index = first;
+    for (; index + 3 <= last; index += 4) {
+      __m128i value = _mm_shuffle_epi8(
+          _mm_loadu_si128(reinterpret_cast<const __m128i*>(base + (index - start_index))),
+          shuffle);
+      __m128i previous = _mm_loadu_si128(
+          reinterpret_cast<const __m128i*>(register_file_->values + index));
+      differences = _mm_or_si128(differences, _mm_xor_si128(previous, value));
+      _mm_storeu_si128(reinterpret_cast<__m128i*>(register_file_->values + index), value);
+    }
+    bool changed = false;
+    for (; index <= last; ++index) {
+      uint32_t value = memory::load_and_swap<uint32_t>(base + (index - start_index));
+      changed |= register_file_->values[index] != value;
+      register_file_->values[index] = value;
+    }
+    return changed || !_mm_testz_si128(differences, differences);
+  };
