diff --git a/include/rex/graphics/d3d12/temporal_math.h b/include/rex/graphics/d3d12/temporal_math.h
new file mode 100644
index 0000000..3d705db
--- /dev/null
+++ b/include/rex/graphics/d3d12/temporal_math.h
@@ -0,0 +1,122 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace rex::graphics::d3d12::temporal {
+using Matrix = std::array<float, 16>;  // Row-major, column vectors.
+inline bool Invert(const Matrix& input, Matrix& output) {
+  double a[4][8]{};
+  for (int r = 0; r < 4; ++r) {
+    for (int c = 0; c < 4; ++c) {
+      if (!std::isfinite(input[r * 4 + c])) return false;
+      a[r][c] = input[r * 4 + c];
+    }
+    a[r][r + 4] = 1;
+  }
+  for (int c = 0; c < 4; ++c) {
+    int pivot = c;
+    for (int r = c + 1; r < 4; ++r)
+      if (std::abs(a[r][c]) > std::abs(a[pivot][c])) pivot = r;
+    if (std::abs(a[pivot][c]) < 1e-12) return false;
+    for (int k = 0; k < 8; ++k) std::swap(a[c][k], a[pivot][k]);
+    double divisor = a[c][c];
+    for (int k = 0; k < 8; ++k) a[c][k] /= divisor;
+    for (int r = 0; r < 4; ++r) {
+      if (r == c) continue;
+      double factor = a[r][c];
+      for (int k = 0; k < 8; ++k) a[r][k] -= factor * a[c][k];
+    }
+  }
+  Matrix result{};
+  for (int r = 0; r < 4; ++r)
+    for (int c = 0; c < 4; ++c) {
+      result[r * 4 + c] = float(a[r][c + 4]);
+      if (!std::isfinite(result[r * 4 + c])) return false;
+    }
+  output = result;
+  return true;
+}
+// Match the shader translator's NDC correction and the actual D3D viewport,
+// then express it relative to the captured rectangle (not the padded target).
+inline Matrix CropProjection(const Matrix& guest, const float scale[3],
+                             const float offset[3],
+                             const uint32_t viewport_offset[2],
+                             const uint32_t viewport_extent[2], float z_min,
+                             float z_max, const uint32_t crop_offset[2],
+                             const uint32_t crop_extent[2]) {
+  Matrix result = guest;
+  for (int r = 0; r < 3; ++r) {
+    float s = scale[r], o = offset[r];
+    if (r < 2) {
+      const float extent_ratio =
+          float(viewport_extent[r]) / float(crop_extent[r]);
+      const float origin = (float(viewport_offset[r]) - float(crop_offset[r])) /
+                           float(crop_extent[r]);
+      s *= extent_ratio;
+      o = o * extent_ratio +
+          (r == 0 ? 1.f : -1.f) * (2.f * origin + extent_ratio - 1.f);
+    } else {
+      s *= z_max - z_min;
+      o = o * (z_max - z_min) + z_min;
+    }
+    for (int c = 0; c < 4; ++c)
+      result[r * 4 + c] = guest[r * 4 + c] * s + guest[12 + c] * o;
+  }
+  return result;
+}
+inline bool ContinuousCamera(const Matrix& current, const Matrix& previous) {
+  Matrix a, b;
+  if (!Invert(current, a) || !Invert(previous, b)) return false;
+  // A point on the central ray avoids assumptions about the game's handedness.
+  const float aw = a[14] * 0.5f + a[15], bw = b[14] * 0.5f + b[15];
+  if (std::abs(aw) < 1e-9f || std::abs(bw) < 1e-9f) return false;
+  double distance_squared = 0;
+  for (int r = 0; r < 3; ++r) {
+    double delta = (a[r * 4 + 2] * 0.5 + a[r * 4 + 3]) / aw -
+                   (b[r * 4 + 2] * 0.5 + b[r * 4 + 3]) / bw;
+    distance_squared += delta * delta;
+  }
+  double dot = 0, aa = 0, bb = 0;
+  for (int i = 12; i < 15; ++i) {
+    dot += double(current[i]) * previous[i];
+    aa += double(current[i]) * current[i];
+    bb += double(previous[i]) * previous[i];
+  }
+  return std::isfinite(distance_squared) && distance_squared < 400 &&
+         aa > 1e-12 && bb > 1e-12 && dot / std::sqrt(aa * bb) > 0.7;
+}
+// A vertical EDRAM tile offsets clip Y by k*W. Recover the full-image row.
+// Reject a different camera/object transform instead of assembling unrelated
+// depth.
+inline int TileOffsetY(const Matrix& full, const Matrix& tile,
+                       uint32_t height) {
+  double ww = 0, yw = 0;
+  for (int c = 0; c < 4; ++c) {
+    ww += double(full[12 + c]) * full[12 + c];
+    yw += double(tile[4 + c] - full[4 + c]) * full[12 + c];
+  }
+  if (ww < 1e-12 || !std::isfinite(ww) || !std::isfinite(yw)) return -1;
+  double k = yw / ww;
+  for (int r = 0; r < 4; ++r)
+    for (int c = 0; c < 4; ++c) {
+      double expected = full[r * 4 + c] + (r == 1 ? k * full[12 + c] : 0);
+      if (!std::isfinite(tile[r * 4 + c]) ||
+          std::abs(tile[r * 4 + c] - expected) >
+              1e-4 * std::max(1.0, std::abs(expected)))
+        return -1;
+    }
+  double row = k * height * 0.5;
+  if (!std::isfinite(row) || row < -0.25 || row > height ||
+      std::abs(row - std::round(row)) > .25)
+    return -1;
+  return int(std::round(row));
+}
+struct alignas(16) Constants {
+  Matrix inverse_current{}, previous{};
+  uint32_t width{}, height{}, origin_x{}, origin_y{};
+  uint32_t mode{}, valid_history{}, reversed_depth{}, padding{};
+};
+static_assert(sizeof(Constants) == 160);
+}  // namespace rex::graphics::d3d12::temporal
diff --git a/include/rex/graphics/d3d12/temporal_shaders.h b/include/rex/graphics/d3d12/temporal_shaders.h
new file mode 100644
index 0000000..d4660c6
--- /dev/null
+++ b/include/rex/graphics/d3d12/temporal_shaders.h
@@ -0,0 +1,93 @@
+#pragma once
+namespace rex::graphics::d3d12::temporal {
+inline constexpr const char* kDepthShader = R"hlsl(
+cbuffer Constants : register(b0) {
+ row_major float4x4 inverseCurrent; row_major float4x4 previous;
+ uint2 size; uint2 origin; uint mode; uint validHistory; uint reversedDepth; uint unused;
+};
+#if SAMPLES == 1
+Texture2D<float> source : register(t0);
+#else
+Texture2DMS<float, SAMPLES> source : register(t0);
+#endif
+RWTexture2D<float> destination : register(u0);
+[numthreads(8,8,1)] void main(uint3 tid : SV_DispatchThreadID) {
+ if (any(tid.xy >= size)) return;
+ uint2 sourcePixel = tid.xy + origin;
+ float depth = reversedDepth ? 0 : 1;
+ for (uint s=0; s<SAMPLES; ++s) {
+#if SAMPLES == 1
+  float value = source.Load(int3(sourcePixel,0));
+#else
+  float value = source.Load(sourcePixel,s);
+#endif
+  if (!isfinite(value) || value < 0 || value > 1) continue;
+  depth = reversedDepth ? max(depth,value) : min(depth,value);
+ }
+ destination[tid.xy + uint2(0,unused)] = depth;
+}
+)hlsl";
+inline constexpr const char* kResolveShader = R"hlsl(
+cbuffer Constants : register(b0) {
+ row_major float4x4 inverseCurrent; row_major float4x4 previous;
+ uint2 size; uint2 origin; uint mode; uint validHistory; uint reversedDepth; uint unused;
+};
+Texture2D<float> depth : register(t0);
+Texture2D<float4> color : register(t1);
+Texture2D<float4> history : register(t2);
+RWTexture2D<float4> output : register(u0);
+RWTexture2D<float4> nextHistory : register(u1);
+RWTexture2D<float2> motion : register(u2);
+SamplerState linearClamp : register(s0);
+[numthreads(8,8,1)] void main(uint3 tid : SV_DispatchThreadID) {
+ if (any(tid.xy >= size)) return;
+ int2 pixel = tid.xy;
+ float2 uv = (float2(pixel)+0.5)/float2(size);
+ float d = depth.Load(int3(pixel,0));
+ float4 current = color.Load(int3(pixel,0));
+ float2 previousUV = uv;
+ float expectedDepth = d;
+ bool valid = validHistory != 0 && isfinite(d) && d >= 0 && d <= 1;
+ valid = valid && (reversedDepth ? d > 1e-7 : d < 1-1e-7);
+ if (valid) {
+  float4 clip = float4(uv.x*2-1,1-uv.y*2,d,1);
+  float4 world = mul(inverseCurrent,clip);
+  float4 oldClip = mul(previous,world);
+  valid = all(isfinite(oldClip)) && oldClip.w > 1e-6;
+  if (valid) {
+   float3 ndc = oldClip.xyz / oldClip.w;
+   previousUV = float2(ndc.x*0.5+0.5,0.5-ndc.y*0.5);
+   expectedDepth = ndc.z;
+   valid = all(previousUV >= 0) && all(previousUV <= 1) && expectedDepth >= 0 && expectedDepth <= 1;
+  }
+ }
+ float2 velocity = valid ? (previousUV-uv)*float2(size) : 0;
+ // Prevent half-float overflow or corrupt vectors from crossing a camera cut.
+ if (!all(isfinite(velocity)) || any(abs(velocity)>float2(size))) {valid=false; velocity=0;}
+ motion[pixel] = velocity;
+ float3 result = current.rgb;
+ if (mode == 3 && valid) {
+  // Camera-only research resolve. Dynamic objects and HUD still require their
+  // own vectors/masks before this is suitable for a production TAA/DLSS path.
+  float4 old = history.SampleLevel(linearClamp,previousUV,0);
+  float3 lo = current.rgb, hi = current.rgb;
+  for (int y=-1; y<=1; ++y) for (int x=-1; x<=1; ++x) {
+   float3 neighbor = color.Load(int3(clamp(pixel+int2(x,y),int2(0,0),int2(size)-1),0)).rgb;
+   lo=min(lo,neighbor); hi=max(hi,neighbor);
+  }
+  float error = max(max(abs(old.r-current.r),abs(old.g-current.g)),abs(old.b-current.b));
+  bool sameSurface = isfinite(old.a) && abs(old.a-expectedDepth) <= max(2e-6,abs(expectedDepth)*0.025);
+  float weight = sameSurface ? 0.8*saturate(1-error*8) : 0;
+  if (sameSurface && all(isfinite(old))) result = lerp(current.rgb,clamp(old.rgb,lo,hi),weight);
+ }
+ nextHistory[pixel] = float4(result,d);
+ if (mode == 1) {
+  float view = reversedDepth ? d/(d+0.0025) : (1-d)/(1-d+0.0025);
+  result = view.xxx;
+ } else if (mode == 2) {
+  result = valid ? float3(0.5+velocity.x/32,0.5+velocity.y/32,0.5) : float3(0,0,0);
+ }
+ output[pixel] = float4(result,current.a);
+}
+)hlsl";
+}  // namespace rex::graphics::d3d12::temporal
