+             << ',' << shader.ucode_data_hash() << ',' << shader.constant_register_map().float_bitmap[0] << ',' << viewport.xy_extent[0] << ',' << viewport.xy_extent[1] << ',' << registers.Get<reg::PA_SC_WINDOW_OFFSET>().window_y_offset << ',' << viewport.ndc_offset[1] << ",\"";
+  for (uint32_t i = 0; i < 1024; ++i) {
+    float value;
+    uint32_t bits = registers[XE_GPU_REG_SHADER_CONSTANT_000_X + i];
+    std::memcpy(&value, &bits, sizeof(value));
+    if (i) trace.file << ' ';
+    trace.file << std::setprecision(9) << value;
