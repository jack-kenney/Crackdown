diff --git a/src/graphics/d3d12/temporal.cpp b/src/graphics/d3d12/temporal.cpp
new file mode 100644
index 0000000..0ec0f93
--- /dev/null
+++ b/src/graphics/d3d12/temporal.cpp
@@ -0,0 +1,324 @@
+#include <d3dcompiler.h>
+#include <rex/cvar.h>
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/d3d12/temporal.h>
+#include <rex/graphics/d3d12/temporal_shaders.h>
+#include <rex/logging.h>
+#include <rex/ui/d3d12/d3d12_presenter.h>
+
+#include <cstring>
+
+REXCVAR_DEFINE_INT32(temporal_mode, 0, "GPU/Experimental",
+                     "Temporal research: 0 off, 1 depth, 2 camera motion, 3 "
+                     "camera-only history resolve, 4 capture-only control")
+    .range(0, 4)
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::d3d12 {
+bool TemporalRendering::Enabled() { return REXCVAR_GET(temporal_mode) != 0; }
+bool TemporalRendering::Initialize() {
+  if (attempted_) return resolve_pipeline_ != nullptr;
+  attempted_ = true;
+  auto* device = cp_.GetD3D12Provider().GetDevice();
+  // RequestOneUseSingleViewDescriptors is explicitly NON-CONTIGUOUS on the
+  // bindless path. Each resource needs its own one-descriptor table.
+  D3D12_DESCRIPTOR_RANGE ranges[6]{};
+  D3D12_ROOT_PARAMETER params[7]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+  params[0].Descriptor = {0, 0};
+  for (int i = 0; i < 6; ++i) {
+    ranges[i] = {i < 3 ? D3D12_DESCRIPTOR_RANGE_TYPE_SRV
+                       : D3D12_DESCRIPTOR_RANGE_TYPE_UAV,
+                 1, UINT(i % 3), 0, 0};
+    params[i + 1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[i + 1].DescriptorTable = {1, &ranges[i]};
+  }
+  D3D12_STATIC_SAMPLER_DESC sampler{};
+  sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+  sampler.AddressU = sampler.AddressV = sampler.AddressW =
+      D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+  sampler.MaxLOD = D3D12_FLOAT32_MAX;
+  sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+  D3D12_ROOT_SIGNATURE_DESC desc{7, params, 1, &sampler,
+                                 D3D12_ROOT_SIGNATURE_FLAG_NONE};
+  Microsoft::WRL::ComPtr<ID3DBlob> blob, errors;
+  if (FAILED(D3D12SerializeRootSignature(&desc, D3D_ROOT_SIGNATURE_VERSION_1,
+                                         &blob, &errors)) ||
+      FAILED(device->CreateRootSignature(0, blob->GetBufferPointer(),
+                                         blob->GetBufferSize(),
+                                         IID_PPV_ARGS(&root_)))) {
+    REXGPU_ERROR(
+        "Temporal: root signature creation failed; leaving presentation "
+        "unchanged");
+    return false;
+  }
+  auto compile = [&](const char* code, const D3D_SHADER_MACRO* macros,
+                     Microsoft::WRL::ComPtr<ID3D12PipelineState>& pipeline) {
+    blob.Reset();
+    errors.Reset();
+    HRESULT hr = D3DCompile(
+        code, std::strlen(code), "crackdown-temporal", macros, nullptr, "main",
+        "cs_5_1", D3DCOMPILE_OPTIMIZATION_LEVEL3 | D3DCOMPILE_ENABLE_STRICTNESS,
+        0, &blob, &errors);
+    if (FAILED(hr)) {
+      REXGPU_ERROR("Temporal shader compilation failed: {}",
+                   errors ? static_cast<const char*>(errors->GetBufferPointer())
+                          : "unknown error");
+      return false;
+    }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pso{};
+    pso.pRootSignature = root_.Get();
+    pso.CS = {blob->GetBufferPointer(), blob->GetBufferSize()};
+    return SUCCEEDED(
+        device->CreateComputePipelineState(&pso, IID_PPV_ARGS(&pipeline)));
+  };
+  const char* sample_counts[] = {"1", "2", "4"};
+  for (int i = 0; i < 3; ++i) {
+    D3D_SHADER_MACRO macros[] = {{"SAMPLES", sample_counts[i]},
+                                 {nullptr, nullptr}};
+    if (!compile(temporal::kDepthShader, macros, capture_pipelines_[i]))
+      return false;
+  }
+  if (!compile(temporal::kResolveShader, nullptr, resolve_pipeline_))
+    return false;
+  REXGPU_INFO("Temporal research initialized: mode {} (camera-only vectors)",
+              REXCVAR_GET(temporal_mode));
+  return true;
+}
+void TemporalRendering::Retire(Resource& resource) {
+  if (resource)
+    retired_.push_back({cp_.GetCurrentSubmission(), std::move(resource)});
+}
+bool TemporalRendering::Resize(uint32_t width, uint32_t height) {
+  std::erase_if(retired_, [&](const Retired& r) {
+    return r.submission <= cp_.GetCompletedSubmission();
+  });
+  if (width_ == width && height_ == height && depth_) return true;
+  if (!width || !height || width > 8192 || height > 8192) return false;
+  Resource depth, color, history[2], motion;
+  auto* device = cp_.GetD3D12Provider().GetDevice();
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+  auto create = [&](DXGI_FORMAT format, D3D12_RESOURCE_STATES state,
+                    Resource& resource) {
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    return SUCCEEDED(device->CreateCommittedResource(
+        &heap, D3D12_HEAP_FLAG_NONE, &desc, state, nullptr,
+        IID_PPV_ARGS(&resource)));
+  };
+  if (!create(DXGI_FORMAT_R32_FLOAT,
+              D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, depth) ||
+      !create(ui::d3d12::D3D12Presenter::kGuestOutputFormat,
+              D3D12_RESOURCE_STATE_COPY_DEST, color) ||
+      !create(DXGI_FORMAT_R16G16B16A16_FLOAT,
+              D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, history[0]) ||
+      !create(DXGI_FORMAT_R16G16B16A16_FLOAT,
+              D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, history[1]) ||
+      !create(DXGI_FORMAT_R16G16_FLOAT, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+              motion))
+    return false;
+  Retire(depth_);
+  Retire(color_);
+  Retire(history_[0]);
+  Retire(history_[1]);
+  Retire(motion_);
+  depth_ = std::move(depth);
+  color_ = std::move(color);
+  history_[0] = std::move(history[0]);
+  history_[1] = std::move(history[1]);
+  motion_ = std::move(motion);
+  width_ = width;
+  height_ = height;
+  history_index_ = 0;
+  previous_frame_ = captured_frame_ = UINT64_MAX;
+  REXGPU_INFO("Temporal viewport: {}x{}; history reset", width, height);
+  return true;
+}
+bool TemporalRendering::Upload(const temporal::Constants& constants,
+                               D3D12_GPU_VIRTUAL_ADDRESS& address) {
+  // This pool is reclaimed by completed FRAME, unlike resource retirement.
+  // A submission index here would pin the shared draw-upload pages
+  // indefinitely.
+  auto* mapping = cp_.GetConstantBufferPool().Request(
+      cp_.GetCurrentFrame(), sizeof(constants), 256, nullptr, nullptr,
+      &address);
+  if (!mapping) {
+    REXGPU_ERROR(
+        "Temporal constant upload failed; device status 0x{:08X}",
+        uint32_t(cp_.GetD3D12Provider().GetDevice()->GetDeviceRemovedReason()));
+    return false;
+  }
+  std::memcpy(mapping, &constants, sizeof(constants));
+  return true;
+}
+bool TemporalRendering::Capture(ID3D12Resource* depth,
+                                D3D12_CPU_DESCRIPTOR_HANDLE srv, uint32_t x,
+                                uint32_t y, uint32_t width, uint32_t height,
+                                bool reversed, const temporal::Matrix& matrix,
+                                uint32_t output_height) {
+  auto desc = depth->GetDesc();
+  if (x + uint64_t(width) > desc.Width || y + uint64_t(height) > desc.Height)
+    return false;
+  unsigned samples = desc.SampleDesc.Count;
+  if (samples != 1 && samples != 2 && samples != 4) return false;
+  if (!Initialize() || !Resize(width, output_height)) return false;
+  const bool first_tile = captured_frame_ != cp_.GetCurrentFrame();
+  if (first_tile) {
+    rows_written_.assign(output_height, 0);
+    matrix_ = matrix;
+  }
+  auto destination_y = temporal::TileOffsetY(matrix_, matrix, output_height);
+  if (destination_y < 0 || uint64_t(destination_y) + height > output_height)
+    return false;
+  temporal::Constants constants{};
+  constants.width = width;
+  constants.height = height;
+  constants.padding = uint32_t(destination_y);
+  constants.origin_x = x;
+  constants.origin_y = y;
+  constants.reversed_depth = reversed;
+  D3D12_GPU_VIRTUAL_ADDRESS address;
+  ui::d3d12::util::DescriptorCpuGpuHandlePair handles[2];
+  if (!Upload(constants, address) ||
+      !cp_.RequestOneUseSingleViewDescriptors(2, handles))
+    return false;
+  auto* device = cp_.GetD3D12Provider().GetDevice();
+  device->CopyDescriptorsSimple(1, handles[0].first, srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+  uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  uav.Format = DXGI_FORMAT_R32_FLOAT;
+  device->CreateUnorderedAccessView(depth_.Get(), nullptr, &uav,
+                                    handles[1].first);
+  cp_.PushTransitionBarrier(depth_.Get(),
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  auto& list = cp_.GetDeferredCommandList();
+  list.D3DSetComputeRootSignature(root_.Get());
+  list.D3DSetComputeRootConstantBufferView(0, address);
+  list.D3DSetComputeRootDescriptorTable(1, handles[0].second);
+  list.D3DSetComputeRootDescriptorTable(4, handles[1].second);
+  cp_.SetExternalPipeline(capture_pipelines_[samples == 1   ? 0
+                                             : samples == 2 ? 1
+                                                            : 2]
+                              .Get());
+  cp_.SubmitBarriers();
+  list.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  cp_.PushTransitionBarrier(depth_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  std::fill(rows_written_.begin() + destination_y,
+            rows_written_.begin() + destination_y + height, 1);
+  reversed_ = reversed;
+  captured_frame_ = cp_.GetCurrentFrame();
+  return true;
+}
+void TemporalRendering::Present(ID3D12Resource* output, uint32_t width,
+                                uint32_t height) {
+  if (REXCVAR_GET(temporal_mode) == 4) {
+    previous_frame_ = UINT64_MAX;
+    return;
+  }
+  auto frame = cp_.GetCurrentFrame();
+  auto reason = cp_.GetD3D12Provider().GetDevice()->GetDeviceRemovedReason();
+  if (FAILED(reason)) {
+    static bool reported = false;
+    if (!reported) {
+      reported = true;
+      REXGPU_ERROR("Temporal device failure: 0x{:08X}", uint32_t(reason));
+    }
+    previous_frame_ = UINT64_MAX;
+    return;
+  }
+  if (captured_frame_ != frame || width != width_ || height != height_ ||
+      !resolve_pipeline_ || rows_written_.size() != height ||
+      std::find(rows_written_.begin(), rows_written_.end(), 0) !=
+          rows_written_.end()) {
+    previous_frame_ = UINT64_MAX;
+    return;
+  }
+  temporal::Constants constants{};
+  if (!temporal::Invert(matrix_, constants.inverse_current)) {
+    previous_frame_ = UINT64_MAX;
+    return;
+  }
+  constants.previous = previous_matrix_;
+  constants.width = width;
+  constants.height = height;
+  constants.mode = REXCVAR_GET(temporal_mode);
+  constants.reversed_depth = reversed_;
+  constants.valid_history =
+      (previous_frame_ != UINT64_MAX && previous_frame_ + 1 == frame &&
+       temporal::ContinuousCamera(matrix_, previous_matrix_));
+  D3D12_GPU_VIRTUAL_ADDRESS address;
+  ui::d3d12::util::DescriptorCpuGpuHandlePair handles[6];
+  if (!Upload(constants, address) ||
+      !cp_.RequestOneUseSingleViewDescriptors(6, handles)) {
+    previous_frame_ = UINT64_MAX;
+    return;
+  }
+  auto* device = cp_.GetD3D12Provider().GetDevice();
+  auto srv = [&](ID3D12Resource* resource, DXGI_FORMAT format, int index) {
+    D3D12_SHADER_RESOURCE_VIEW_DESC d{};
+    d.Format = format;
+    d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    d.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    d.Texture2D.MipLevels = 1;
+    device->CreateShaderResourceView(resource, &d, handles[index].first);
+  };
+  auto uav = [&](ID3D12Resource* resource, DXGI_FORMAT format, int index) {
+    D3D12_UNORDERED_ACCESS_VIEW_DESC d{};
+    d.Format = format;
+    d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(resource, nullptr, &d,
+                                      handles[index].first);
+  };
+  srv(depth_.Get(), DXGI_FORMAT_R32_FLOAT, 0);
+  srv(color_.Get(), ui::d3d12::D3D12Presenter::kGuestOutputFormat, 1);
+  srv(history_[history_index_].Get(), DXGI_FORMAT_R16G16B16A16_FLOAT, 2);
+  auto next = history_index_ ^ 1;
+  uav(output, ui::d3d12::D3D12Presenter::kGuestOutputFormat, 3);
+  uav(history_[next].Get(), DXGI_FORMAT_R16G16B16A16_FLOAT, 4);
+  uav(motion_.Get(), DXGI_FORMAT_R16G16_FLOAT, 5);
+  auto& list = cp_.GetDeferredCommandList();
+  cp_.PushTransitionBarrier(
+      output, ui::d3d12::D3D12Presenter::kGuestOutputInternalState,
+      D3D12_RESOURCE_STATE_COPY_SOURCE);
+  cp_.SubmitBarriers();
+  list.D3DCopyResource(color_.Get(), output);
+  cp_.PushTransitionBarrier(color_.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  cp_.PushTransitionBarrier(output, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  cp_.PushTransitionBarrier(history_[next].Get(),
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  cp_.PushUAVBarrier(motion_.Get());
+  list.D3DSetComputeRootSignature(root_.Get());
+  list.D3DSetComputeRootConstantBufferView(0, address);
+  for (int i = 0; i < 6; ++i)
+    list.D3DSetComputeRootDescriptorTable(i + 1, handles[i].second);
+  cp_.SetExternalPipeline(resolve_pipeline_.Get());
+  cp_.SubmitBarriers();
+  list.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  cp_.PushTransitionBarrier(
+      output, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+      ui::d3d12::D3D12Presenter::kGuestOutputInternalState);
+  cp_.PushTransitionBarrier(color_.Get(),
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                            D3D12_RESOURCE_STATE_COPY_DEST);
+  cp_.PushTransitionBarrier(history_[next].Get(),
+                            D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  previous_frame_ = frame;
+  previous_matrix_ = matrix_;
+  history_index_ = next;
+}
